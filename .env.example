# Copy to .env.local and fill the services you want live.
# The shop runs without these keys. Payments stay in demo mode until Moolre is set.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-string

# Supabase — database, authentication, and product image storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAIL=admin@velora.gh

# Moolre — Mobile Money (MTN 13, Telecel 6, AT 7)
MOOLRE_USERNAME=
MOOLRE_PUBLIC_KEY=
MOOLRE_ACCOUNT_NUMBER=
MOOLRE_WEBHOOK_SECRET=
# MOOLRE_SKIP_OTP=true

# Resend — order and contact email
RESEND_API_KEY=
RESEND_FROM=Velora <onboarding@resend.dev>
CONTACT_INBOX=

# Taysend — order SMS
TAYSEND_API_KEY=
TAYSEND_SENDER_ID=VELORA
TAYSEND_WEBHOOK_SECRET=
